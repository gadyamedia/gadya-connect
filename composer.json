{
    "name": "gadya/connect",
    "description": "Connects a Laravel site to the Gadya Media portal: signed check-ins with versions and health, help from inside the admin, and one-click sign-in for the Gadya team.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-health": "^1.30",
        "spatie/laravel-package-tools": "^1.16"
    },
    "suggest": {
        "filament/filament": "For the Gadya Support page in the admin (Filament 4 or 5)."
    },
    "autoload": {
        "psr-4": {
            "Gadya\\Connect\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gadya\\Connect\\GadyaConnectServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": ["laravel", "filament", "monitoring", "support", "gadya"],
    "homepage": "https://github.com/gadyamedia/gadya-connect",
    "authors": [
        {
            "name": "Gadya Media",
            "email": "antony@gadyamedia.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gadyamedia/gadya-connect/issues",
        "source": "https://github.com/gadyamedia/gadya-connect"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Gadya\\Connect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint"
    }
}
